#!/usr/bin/env python3
"""Print the real chronology, read from commit trailers.

Git's own dates carry a +1000 year offset because git cannot represent a year
before 1970. The trailers carry the truth, so this is what `git log` would show
if git could count that far back.

Usage:  scripts/timeline [path-to-generated-repo]
"""
import datetime
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def main():
    repo = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / ".build" / "repo"
    if not (repo / ".git").exists():
        raise SystemExit(f"no generated repo at {repo}; run scripts/build_history.py first")
    out = subprocess.run(
        ["git", "-C", str(repo), "log", "--all", "--format=%H%x1f%an%x1f%B%x1e"],
        capture_output=True, text=True, check=True).stdout

    def full_years(start, end):
        a = datetime.date.fromisoformat(start)
        b = datetime.date.fromisoformat(end)
        return b.year - a.year - ((b.month, b.day) < (a.month, a.day))

    rows = []
    # git log is newest-first; reverse so equal dates keep chronological order
    # under the stable sort below.
    for entry in reversed(out.split("\x1e")):
        if not entry.strip():
            continue
        _, author, body = entry.strip().split("\x1f", 2)
        subject = body.strip().split("\n")[0]
        def trailer(name):
            m = re.search(rf"^{name}:\s*(\d{{4}}-\d{{2}}-\d{{2}})\s*$", body, re.M)
            return m.group(1) if m else None
        signed, real = trailer("Signed-Date"), trailer("Real-Date")
        prop, rat = trailer("Proposed-Date"), trailer("Ratified-Date")
        when = rat or signed or real or prop
        if not when:
            continue
        gap = ""
        if rat and prop and rat != prop:
            years = full_years(prop, rat)
            if years >= 5:
                gap = f"  ({years} years after proposal)"
        rows.append((when, author, subject, gap))

    seen = set()
    for when, author, subject, gap in sorted(rows, key=lambda r: r[0]):
        key = (when, subject)
        if key in seen:
            continue
        seen.add(key)
        print(f"{when}  {subject}{gap}")
        print(f"{'':10}  {author}")


if __name__ == "__main__":
    main()
